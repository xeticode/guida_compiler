{
  "targets": {
    "release": {
      "outFile": "lib/wasm/guida-core.wasm",
      "textFile": "lib/wasm/guida-core.wat",
      "sourceMap": true,
      "optimizeLevel": 3,
      "shrinkLevel": 2,
      "converge": true,
      "noAssert": true
    },
    "debug": {
      "outFile": "lib/wasm/guida-core.debug.wasm",
      "textFile": "lib/wasm/guida-core.debug.wat",
      "sourceMap": true,
      "debug": true
    }
  },
  "options": {
    "bindings": "esm"
  }
}
